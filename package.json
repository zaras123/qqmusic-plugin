{
  "name": "karin-plugin-qqmusic",
  "version": "2.1.11",
  "description": "Karin QQ 音乐点歌/解析插件（node-karin），对接 qqmusic-api-enhanced",
  "type": "module",
  "main": "dist/index.js",
  "author": "local",
  "license": "MIT",
  "karin": {
    "main": "index.ts",
    "apps": [
      "dist/apps"
    ],
    "ts-apps": [
      "apps"
    ],
    "web": "dist/web.config.js",
    "ts-web": "web.config.ts",
    "files": [
      "config",
      "data",
      "resources"
    ],
    "static": [
      "resources"
    ],
    "engines": "^1.18.0"
  },
  "scripts": {
    "test:listening": "npm run build && node --test scripts/test-listening.mjs",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node test.mjs && node --test scripts/test-library-channels.mjs",
    "test:channels": "npm run build && node --test scripts/test-library-channels.mjs",
    "test:ticket": "npm run build && node --test scripts/test-ticket.mjs",
    "test:stats": "npm run build && node --test scripts/test-stats.mjs",
    "test:medal": "npm run build && node --test scripts/test-medal.mjs",
    "test:external": "npm run build && node scripts/test-external-resolve.mjs",
    "gen-logo": "node ./scripts/gen-logo.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "node-karin": "^1.18.0",
    "typescript": "^7.0.2"
  }
}
